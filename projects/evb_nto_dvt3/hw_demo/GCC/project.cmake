
set(CONFIG_BOARD "Daric-Activecard-NTO-DVT3")
set(CONFIG_SOC_DARIC_NTO_A "y")
set(CONFIG_NEWLIB_LIBC "y")
# Cannot use J-linK debugging if cache is enabled.
#set(CONFIG_DISABLE_CACHE "y")
set(CONFIG_MAIN_TASK_STACK_SIZE "2048")
#support SRAM_MODE|ITCM_MODE|RERAM_MODE|RERAM_BLOADER_MODE,default is RERAM_MODE
set(CONFIG_EXECUTION_MODE "RERAM_BLOADER_MODE")
#support ED028TC1_480X600|SSD1685_200X300, default is SSD1685_200X300
set(CONFIG_RESOLUTION_MODE "ED028TC1_480X600")
set(CONFIG_SUPPORT_800MFREQ "y")
# To avoid the issue of inaccurate I2C frequency calculations,
# provide three fixed configurations at a 700 MHz main frequency.
set(CONFIG_I2C_FIXED_DIV_TABLE "y")

